{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthesis System Map V1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "lifecycleState": {
      "type": "string",
      "enum": [
        "PLANNED",
        "AVAILABLE",
        "INSTALLING",
        "INSTALLED",
        "ENABLED",
        "DISABLED",
        "MAINTENANCE",
        "REMOVED"
      ]
    },
    "stringRefArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stableId"
      }
    }
  },
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "projectKey": {
      "$ref": "#/$defs/stableId"
    },
    "defaultLocale": {
      "type": "string",
      "const": "cs-CZ"
    },
    "supportedLocales": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "appIdentity": { "$ref": "#/$defs/stableId" },
          "moduleKey": { "$ref": "#/$defs/stableId" },
          "lifecycleState": { "$ref": "#/$defs/lifecycleState" },
          "enabled": { "type": "boolean" },
          "status": { "type": "string" }
        },
        "required": [
          "appIdentity",
          "moduleKey",
          "lifecycleState",
          "enabled",
          "status"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "lifecycleState": { "const": "PLANNED" }
              }
            },
            "then": {
              "properties": {
                "enabled": { "const": false }
              }
            }
          }
        ]
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "routeId": { "$ref": "#/$defs/stableId" },
          "appIdentity": { "$ref": "#/$defs/stableId" },
          "moduleKey": { "$ref": "#/$defs/stableId" },
          "path": { "type": "string" },
          "lifecycleState": { "$ref": "#/$defs/lifecycleState" },
          "enabled": { "type": "boolean" },
          "status": { "type": "string" }
        },
        "required": [
          "routeId",
          "appIdentity",
          "moduleKey",
          "lifecycleState",
          "enabled",
          "status"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "lifecycleState": { "const": "PLANNED" }
              }
            },
            "then": {
              "properties": {
                "enabled": { "const": false }
              }
            }
          }
        ]
      }
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "surfaceId": { "$ref": "#/$defs/stableId" },
          "appIdentity": { "$ref": "#/$defs/stableId" },
          "routeId": { "$ref": "#/$defs/stableId" },
          "moduleKey": { "$ref": "#/$defs/stableId" },
          "status": { "type": "string" }
        },
        "required": [
          "surfaceId",
          "appIdentity",
          "routeId",
          "moduleKey",
          "status"
        ]
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "regionId": { "$ref": "#/$defs/stableId" },
          "surfaceId": { "$ref": "#/$defs/stableId" },
          "moduleKey": { "$ref": "#/$defs/stableId" },
          "status": { "type": "string" }
        },
        "required": [
          "regionId",
          "surfaceId",
          "moduleKey",
          "status"
        ]
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "componentId": { "$ref": "#/$defs/stableId" },
          "regionId": { "$ref": "#/$defs/stableId" },
          "moduleKey": { "$ref": "#/$defs/stableId" },
          "sourcePath": { "type": "string" },
          "status": { "type": "string" }
        },
        "required": [
          "componentId",
          "regionId",
          "moduleKey",
          "status"
        ]
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "elementId": { "$ref": "#/$defs/stableId" },
          "appIdentity": { "$ref": "#/$defs/stableId" },
          "routeId": { "$ref": "#/$defs/stableId" },
          "surfaceId": { "$ref": "#/$defs/stableId" },
          "regionId": { "$ref": "#/$defs/stableId" },
          "componentId": { "$ref": "#/$defs/stableId" },
          "moduleKey": { "$ref": "#/$defs/stableId" },
          "lifecycleState": { "$ref": "#/$defs/lifecycleState" },
          "enabled": { "type": "boolean" },
          "contentKey": { "$ref": "#/$defs/stableId" },
          "helpKey": { "$ref": "#/$defs/stableId" },
          "disabledReasonKey": { "$ref": "#/$defs/stableId" },
          "themeTokens": { "$ref": "#/$defs/stringRefArray" },
          "assetRefs": { "$ref": "#/$defs/stringRefArray" },
          "permissionKeys": { "$ref": "#/$defs/stringRefArray" },
          "actionKeys": { "$ref": "#/$defs/stringRefArray" },
          "apiRefs": { "$ref": "#/$defs/stringRefArray" },
          "eventRefs": { "$ref": "#/$defs/stringRefArray" },
          "jobRefs": { "$ref": "#/$defs/stringRefArray" },
          "dataOwner": { "$ref": "#/$defs/stableId" },
          "testRefs": { "$ref": "#/$defs/stringRefArray" },
          "taskId": { "type": "string" },
          "introducedCommit": { "type": "string" },
          "status": { "type": "string" },
          "sourcePath": { "type": "string" }
        },
        "required": [
          "elementId",
          "appIdentity",
          "routeId",
          "surfaceId",
          "regionId",
          "componentId",
          "moduleKey",
          "lifecycleState",
          "enabled",
          "status"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "lifecycleState": { "const": "PLANNED" }
              }
            },
            "then": {
              "properties": {
                "enabled": { "const": false }
              },
              "required": ["disabledReasonKey"]
            }
          }
        ]
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "actionKey": { "$ref": "#/$defs/stableId" },
          "moduleKey": { "$ref": "#/$defs/stableId" },
          "kind": {
            "type": "string",
            "enum": [
              "NAVIGATE",
              "COMMAND",
              "SUBMIT",
              "TOGGLE",
              "OPEN_DIALOG",
              "CLOSE_DIALOG",
              "DOWNLOAD",
              "UPLOAD",
              "SEARCH",
              "FILTER",
              "SORT",
              "PAGINATE",
              "EXTERNAL_LINK"
            ]
          },
          "lifecycleState": { "$ref": "#/$defs/lifecycleState" },
          "enabled": { "type": "boolean" },
          "disabledReasonKey": { "$ref": "#/$defs/stableId" },
          "permissionKeys": { "$ref": "#/$defs/stringRefArray" },
          "targetRouteId": { "$ref": "#/$defs/stableId" },
          "apiRefs": { "$ref": "#/$defs/stringRefArray" },
          "eventRefs": { "$ref": "#/$defs/stringRefArray" },
          "jobRefs": { "$ref": "#/$defs/stringRefArray" },
          "auditEventKey": { "$ref": "#/$defs/stableId" },
          "aiToolKey": { "$ref": "#/$defs/stableId" },
          "taskId": { "type": "string" },
          "status": { "type": "string" }
        },
        "required": [
          "actionKey",
          "moduleKey",
          "kind",
          "lifecycleState",
          "enabled",
          "status"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "lifecycleState": { "const": "PLANNED" }
              }
            },
            "then": {
              "properties": {
                "enabled": { "const": false }
              },
              "required": ["disabledReasonKey"]
            }
          }
        ]
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "moduleKey": { "$ref": "#/$defs/stableId" },
          "lifecycleState": { "$ref": "#/$defs/lifecycleState" },
          "enabled": { "type": "boolean" },
          "dependencies": { "$ref": "#/$defs/stringRefArray" },
          "capabilities": { "$ref": "#/$defs/stringRefArray" },
          "permissionKeys": { "$ref": "#/$defs/stringRefArray" },
          "auditNamespace": { "$ref": "#/$defs/stableId" },
          "aiNamespace": { "$ref": "#/$defs/stableId" },
          "dataOwners": { "$ref": "#/$defs/stringRefArray" },
          "taskId": { "type": "string" },
          "status": { "type": "string" }
        },
        "required": [
          "moduleKey",
          "lifecycleState",
          "enabled",
          "status"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "lifecycleState": { "const": "PLANNED" }
              }
            },
            "then": {
              "properties": {
                "enabled": { "const": false }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "projectKey",
    "defaultLocale",
    "supportedLocales",
    "apps",
    "routes",
    "surfaces",
    "regions",
    "components",
    "elements",
    "actions",
    "modules"
  ]
}
